<%#
  Cartão de experiência. Parâmetros:
    e     linha do catálogo (catalogRepository)
    full  título completo (catálogo) ou curto (carrossel)
    meta  mostra próxima data e avaliações
    eager carrega a imagem sem lazy (primeiro cartão visível)
  O link fica no título e cobre o cartão todo (::after); assim o botão
  de favoritar, por cima da foto, não fica dentro de um link.
%>
<%
  const c = capaDe(e);
  const sc = aquaScore(e.slug);
  const preco = Math.round(e.price_cents / 100);
  const temVaga = Boolean(e.proxima_data);
  const fav = Boolean(locals.favoritos && locals.favoritos.has && locals.favoritos.has(e.id));
%>
<article class="exp-card">
  <figure class="exp-media">
    <img src="<%= c.src %>" alt="<%= c.alt %>" <%- locals.eager ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
    <span class="exp-price"><span class="sr-only"><%= t('home.preco_pessoa_sr') %> </span>R$ <%= preco.toLocaleString(locals.intl || 'pt-BR') %> <small><%= t('home.por_pessoa') %></small></span>
    <% if (e.exemplo) { %><span class="exp-tag"><%= t('comunidade.exemplo') %></span><% } else if (c.ilustrativa && locals.full) { %><span class="exp-tag"><%= categoriaRotulo(e.category) %></span><% } %>
    <button type="button" class="fav-btn<%= fav ? ' is-on' : '' %>" data-favorito="<%= e.id %>" aria-pressed="<%= fav %>"
            aria-label="<%= t('favoritos.salvar_aria', { titulo: e.title }) %>"<%= locals.user ? '' : ' data-login' %>><i data-lucide="bookmark"></i></button>
  </figure>
  <p class="exp-loc"><i data-lucide="map-pin"></i> <%= e.location || t('home.brasil') %></p>
  <h3 class="exp-title"><a class="exp-link" href="/reservar/<%= encodeURIComponent(e.slug) %>"><%= e.title %></a></h3>
  <% if (locals.full && e.description) { %><p class="exp-desc"><%= e.description %></p><% } %>
  <% if (sc && !locals.full) { %>
    <ul class="score" aria-label="<%= t('home.score_aria') %>">
      <li><b><%= sc[0] %></b><span><%= t('home.score_aventura') %></span></li>
      <li><b><%= sc[1] %></b><span><%= t('home.score_natureza') %></span></li>
      <li><b><%= sc[2] %></b><span><%= t('home.score_relax') %></span></li>
    </ul>
  <% } %>
  <p class="exp-meta">
    <% if (locals.meta) { %>
      <span class="<%= temVaga ? '' : 'is-off' %>"><i data-lucide="calendar-check"></i>
        <% if (temVaga) { %><%= t('home.proxima', { data: fmt.diaCurto(e.proxima_data), hora: fmt.hora(e.proxima_data) }) %><% } else { %><%= t('home.sem_datas') %><% } %>
      </span>
      <% if (e.total_avaliacoes > 0) { %>
        <span class="exp-rating"><span aria-hidden="true">★</span> <%= e.nota_media.toLocaleString(locals.intl || 'pt-BR', { minimumFractionDigits: 1 }) %>
          <span class="sr-only"><%= t('home.de_5') %>,</span> (<%= t(e.total_avaliacoes === 1 ? 'home.avaliacao_uma' : 'home.avaliacao_varias', { n: e.total_avaliacoes }) %>)</span>
      <% } %>
    <% } %>
    <% if (!sc || locals.full) { %><span><i data-lucide="badge-check"></i> <%= e.operador || 'AquaTrip' %></span><% } %>
  </p>
</article>
